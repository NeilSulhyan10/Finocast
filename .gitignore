# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# test and coverage output
/coverage

# logs, temporary files, and local caches
*.log
*.tmp
*.swp
*~
/.turbo/
/logs/

# next.js
/.next/
/out/

# generated build output
/build
/dist

# misc
.DS_Store
*.pem

# editor and OS metadata
.idea/
.vscode/
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment secrets (keep the checked-in placeholder template)
.env
.env*
!.env.example

# local Supabase CLI state; preserve config and migrations
/.supabase/
/supabase/.temp/
/supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
